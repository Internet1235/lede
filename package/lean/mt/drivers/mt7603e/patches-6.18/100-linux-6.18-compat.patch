Subject: [PATCH] mt7603e: fix Linux 6.18 Kbuild and kernel API compatibility

Pass legacy feature flags to modern Kbuild and use kernel-owned headers.
Drop unused address-limit state, replace removed PCI DMA wrappers without
changing their GFP_ATOMIC allocation semantics, and update timer callbacks
and cancellation to the current kernel API.

--- a/mt7603_wifi_ap/Makefile
+++ b/mt7603_wifi_ap/Makefile
@@ -1014,3 +1014,5 @@
 
 MODULE_FLAGS=$(EXTRA_CFLAGS)
 export MODULE_FLAGS
+
+ccflags-y += $(EXTRA_CFLAGS)
--- a/mt7603_wifi/include/os/rt_linux.h
+++ b/mt7603_wifi/include/os/rt_linux.h
@@ -28,6 +28,7 @@
