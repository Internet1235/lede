+	dma_free_coherent(&((struct pci_dev *)(_pci_dev))->dev, _size, _virtual_addr, _physical_addr)
 
 #ifdef VENDOR_FEATURE2_SUPPORT
 #define DEV_ALLOC_SKB(_pAd, _Pkt, _length)	\
